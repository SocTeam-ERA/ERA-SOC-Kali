{
  "ignore_entities": [],
  "rules": [
    {
      "id": "scan-then-exploit",
      "name": "Scan followed by exploit attempt",
      "severity": "critical",
      "type": "sequence",
      "window_minutes": 60,
      "steps": [
        {
          "detector": [
            "traffic_capture",
            "suricata"
          ],
          "title_regex": "(^Port scan on the wire|^ET SCAN\\b)"
        },
        {
          "detector": "suricata",
          "title_regex": "^ET (EXPLOIT|WEB_SERVER|WEB_SPECIFIC_APPS)\\b"
        }
      ]
    },
    {
      "id": "bruteforce-then-login",
      "name": "Brute force followed by a successful login",
      "severity": "critical",
      "type": "sequence",
      "window_minutes": 30,
      "steps": [
        {
          "detector": [
            "login_monitor",
            "zeek"
          ],
          "title_regex": "^(Brute-force|Failed login from unknown IP|SSH::Password_Guessing)"
        },
        {
          "detector": "login_monitor",
          "title_regex": "^(Login from NEW IP|Successful login after)"
        }
      ]
    },
    {
      "id": "new-device-then-scan",
      "name": "New device that then scans the network",
      "severity": "critical",
      "type": "sequence",
      "window_minutes": 1440,
      "steps": [
        {
          "detector": "arp_discovery",
          "title_regex": "^(New device on VLAN|\\d+ new device\\(s\\) on VLAN)"
        },
        {
          "detector": [
            "traffic_capture",
            "suricata"
          ],
          "title_regex": "(^Port scan on the wire|^ET SCAN\\b)"
        }
      ]
    },
    {
      "id": "multi-source-host",
      "name": "Several detectors flagged the same host",
      "severity": "medium",
      "type": "threshold",
      "window_minutes": 30,
      "count": 3,
      "distinct": "detector",
      "match": {
        "detector": [
          "login_monitor",
          "suricata",
          "zeek",
          "traffic_capture",
          "osquery",
          "chkrootkit",
          "malware_detector",
          "phishing_detector",
          "arp_discovery"
        ],
        "severity": [
          "medium",
          "critical"
        ]
      }
    },
    {
      "id": "threat-intel-ip",
      "name": "Contact with a known-malicious IP",
      "severity": "critical",
      "type": "single",
      "match": {
        "details_has": [
          "threat_intel.ip_matches"
        ]
      },
      "roles": [
        "source",
        "destination"
      ]
    },
    {
      "id": "kev-exploit-activity",
      "name": "Activity involving a known-exploited vulnerability",
      "severity": "medium",
      "type": "single",
      "match": {
        "details_has": [
          "threat_intel.kev"
        ]
      }
    },
    {
      "id": "unmanaged-windows-device",
      "name": "New device that is a Windows machine outside the domain",
      "severity": "medium",
      "type": "threshold",
      "window_minutes": 10080,
      "count": 2,
      "distinct": "detector",
      "match": {
        "detector": [
          "arp_discovery",
          "ad_inventory"
        ],
        "title_regex": "^(New device on VLAN(?!.*randomized)|Windows host not in the domain)"
      }
    },
    {
      "id": "new-device-exposes-services",
      "name": "New device that exposes network services",
      "severity": "medium",
      "type": "threshold",
      "window_minutes": 1440,
      "count": 2,
      "distinct": "detector",
      "match": {
        "detector": [
          "arp_discovery",
          "kali_scan"
        ],
        "title_regex": "^(New device on VLAN (?!10\\.21\\.)(?!.*randomized)|NEW open port .* on (?!10\\.21\\.))"
      }
    },
    {
      "id": "exposed-unpatched-host",
      "name": "Unsupported Windows that is also exposed on the network",
      "severity": "medium",
      "type": "threshold",
      "window_minutes": 10080,
      "count": 2,
      "distinct": "title",
      "match": {
        "detector": [
          "ad_inventory",
          "kali_scan",
          "traffic_capture"
        ],
        "title_regex": "^(Unsupported Windows|SMB signing not required|Cleartext protocol)"
      }
    },
    {
      "id": "unmanaged-host-scanning",
      "name": "Unmanaged or new machine scanning the network",
      "severity": "critical",
      "type": "sequence",
      "window_minutes": 10080,
      "steps": [
        {
          "detector": [
            "arp_discovery",
            "ad_inventory"
          ],
          "title_regex": "^(New device on VLAN|\\d+ new device\\(s\\) on VLAN|Windows host not in the domain)"
        },
        {
          "detector": [
            "traffic_capture",
            "suricata"
          ],
          "title_regex": "(^Port scan on the wire|^ET SCAN\\b)"
        }
      ]
    }
  ],
  "_comment_2026_09_24": "The last four rules use what the Kali sees without a mirror port (new devices, the AD inventory, the scans, cleartext on the wire). The Wiping VLAN (10.21.0.0/16) is left out of new-device-exposes-services: racks come and go there all the time. Replayed against the history before enabling: correlate.py --replay."
}

[Unit]
Description=Sentinel SOC results API
After=network-online.target
Wants=network-online.target
 
[Service]
User=adelcueto
WorkingDirectory=/opt/sentinel-soc/scripts
EnvironmentFile=/etc/sentinel-soc/soc-api.env
Environment=SOC_API_HOST=0.0.0.0
Environment=SOC_API_PORT=8080
ExecStart=/usr/bin/python3 /opt/sentinel-soc/scripts/soc_api.py
Restart=always
RestartSec=5
 
[Install]
WantedBy=multi-user.target
